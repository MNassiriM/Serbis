# ============================================================
# GenERP — Environment Variables Example
# Copy to .env and fill in your values (never commit .env!)
# ============================================================

# --------------------------
# Anthropic (LLM)
# --------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# --------------------------
# Supabase (Database + Auth + Storage)
# --------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
METADATA_DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --------------------------
# APISIX (API Gateway)
# --------------------------
APISIX_ADMIN_URL=http://apisix:9180
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# --------------------------
# Application
# --------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-32-char-secret-key-here!!
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
LOG_LEVEL=INFO

# --------------------------
# Next.js (public, exposed to browser)
# --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:8000
